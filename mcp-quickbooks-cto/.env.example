PORT=3000

# Token que debe mandar el cliente MCP en "Authorization: Bearer <token>".
# Generar con: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Mismas credenciales de la app QuickBooks de Intuit usadas por las
# Edge Functions quickbooks-* (ver infra/supabase-selfhosted).
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=production

# Supabase self-hosted (service_role, nunca el anon key) — para leer/
# refrescar el token guardado en quickbooks_connections. Se usa la URL
# pública (este contenedor vive en su propio docker-compose, sin acceso
# directo a la red interna del stack de Supabase).
SUPABASE_URL=https://prosaludgold-api.plataformapty.cloud
SUPABASE_SERVICE_ROLE_KEY=

# uid (auth.users.id) del dueño de Centro de Terapias Orientales S.A. en
# clinic_config — este MCP está escopado a un solo tenant, este.
CTO_OWNER_USER_ID=
